{#
Concurrent tone-detection hangup scenario.

One accept handles N incoming calls; the call action uses repeat/
repeat_interval to launch calls back-to-back with minimal pacing so
many are in-flight at the same time. Each leg plays a detectable tone
and has hangup_on_tone="true", so the tone detector is destroyed
while the conference bridge is still processing audio — the exact
race pjproject PR 5394 fixes.

A healthy build completes all N calls and exits cleanly. Without the
fix this intermittently crashes in the conference clock thread; the
test can only observe that as a non-zero exit or missing results.
#}
<config>
  <actions>
    <action type="codec" disable="all"/>
    <action type="codec" enable="pcmu" priority="250"/>

    <action type="accept"
            transport="udp"
            account="default"
            code="200"
            reason="OK"
            ring_duration="0"
            hangup="{{ hangup_s | default(10) }}"
            rtp_stats="true"
            detect_tone="440,480"
            hangup_on_tone="true"
            record="false"/>

    <action type="call"
            transport="udp"
            label="concurrent-tone-hangup"
            caller="caller@127.0.0.1"
            callee="callee@127.0.0.1:{{ sip_port }}"
            max_duration="{{ hangup_s | default(10) + 10 }}"
            expected_cause_code="200"
            hangup="{{ hangup_s | default(10) }}"
            detect_tone="440,480"
            hangup_on_tone="true"
            rtp_stats="true"
            repeat="{{ repeat | default(9) }}"
            repeat_interval="{{ repeat_interval_ms | default(50) }}">
      <play type="tones" value="440+480,2000,4000"/>
    </action>

    <action type="wait" complete="true"/>
  </actions>
</config>
